# =========================
# RouteFlow - .gitignore raíz
# =========================

# ---- Sistema operativo ----
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
*~
.directory
.Trash-*
.nfs*

# ---- Editores / IDEs ----
# VS Code (se comparten solo settings y extensiones recomendadas)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
# Cursor (se comparten las reglas del proyecto)
.cursor/*
!.cursor/rules/
# Antigravity / otros IDEs basados en VS Code
.antigravity/
# JetBrains
.idea/
*.iml
# Vim / Emacs / Sublime
*.swp
*.swo
*.sublime-workspace
.#*

# ---- Node.js (frontend y backend) ----
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Builds
dist/
build/
out/
.next/
.vite/
.turbo/
.cache/

# Tests y cobertura
coverage/
.nyc_output/

# ---- Python (servicio FastAPI) ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ---- Variables de entorno y secretos ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Docker / datos locales ----
docker-compose.override.yml
postgres-data/
pgdata/
# Datos de mapas para OSRM (pesan cientos de MB)
osrm-data/
*.osm.pbf
*.osrm
*.osrm.*

# ---- Logs y temporales ----
*.log
logs/
tmp/
temp/
*.tmp