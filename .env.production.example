# ==============================================================================
# ROUTEFLOW SAAS - PLANTILLA DE CONFIGURACIÓN DE PRODUCCIÓN (.env)
# ==============================================================================
# Copia este archivo en el VPS como /opt/routeflow/.env y asigna valores reales.
# Permisos recomendados: chmod 600 /opt/routeflow/.env

# --- Registro de Contenedores e Imágenes ---
REGISTRY=ghcr.io
# Debe coincidir con el nombre de repositorio en GitHub en minúsculas (ej: organizacion/routeflow-saas)
IMAGE_PREFIX=usuario-o-org/routeflow-saas
# El workflow de CD exporta IMAGE_TAG automáticamente con el sha del commit, pero
# puedes definir un tag por defecto para operaciones manuales:
IMAGE_TAG=latest

# --- Puertos del Host (VPS) ---
FRONTEND_PORT=80
BACKEND_PORT=3000
OPTIMIZER_PORT=8000
POSTGRES_PORT=5432
OSRM_PORT=5000

# --- Base de Datos (PostgreSQL + PostGIS) ---
POSTGRES_USER=routeflow_admin
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_PROD
POSTGRES_DB=routeflow
DATABASE_URL=postgresql://routeflow_admin:CAMBIAR_POR_PASSWORD_SEGURO_PROD@postgres:5432/routeflow
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Seguridad y Autenticación ---
# Generar con: openssl rand -base64 32
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_CRIPTOGRAFICO_DE_AL_MENOS_32_CARACTERES

# --- URLs de la Aplicación ---
# URL pública donde los usuarios acceden al frontend
FRONTEND_URL=https://tu-dominio.com

# --- Configuración del Motor de Optimización ---
SOLVER_TIME_LIMIT_SECONDS=10
