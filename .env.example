# Copia este archivo como .env (no se sube al repo) y ajusta los valores.

# Base de datos
POSTGRES_USER=routeflow
POSTGRES_PASSWORD=routeflow_dev
POSTGRES_DB=routeflow

# Backend
JWT_SECRET=cambia-este-secreto

# Frontend: URL del backend vista desde el NAVEGADOR (se fija al construir la imagen)
VITE_API_URL=http://localhost:3000

# Mapa para OSRM (descarga solo la primera vez). Para otra región, cambia la URL
# y borra el volumen osrm-data (docker compose down -v).
OSRM_MAP_URL=https://download.geofabrik.de/south-america/colombia-latest.osm.pbf

# Optimizer
SOLVER_TIME_LIMIT_SECONDS=10
